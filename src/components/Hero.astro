---
// Sitemap §13.2 item 2. Frase-síntese: DESIGN.md §2, exceção documentada
// às 7 palavras.
//
// Revertido em 2026-09-11 (DESIGN.md §9/§13.2): a it. 8 tinha fundido
// este herói com um vídeo de rolagem numa "abertura cinematográfica" —
// corrigimos scroll-jacking, sticky quebrado e travamento de buffer
// nesse meio-tempo, mas o usuário pediu pra voltar a uma imagem fixa
// no mesmo dia. Volta ao Efeito 2 da §9: paralaxe em foto full-bleed
// (foto mais lenta que o texto, teto de 12% da altura), a mesma
// técnica de antes da it. 8, agora sobre fotos/home.png.
//
// home.png é gerado por IA (mesma origem do vídeo revertido) —
// decisão consciente do usuário, já registrada em DESIGN.md §11 item
// 7, não precisa reconfirmar aqui.
import { Picture } from 'astro:assets';
import fachada from '../../fotos/home.png';
import CTABotao from './CTABotao.astro';
---

<section class="hero" data-parallax-container aria-labelledby="hero-titulo">
  <!-- fallbackFormat="jpg" mesmo a fonte sendo .png: o fallback em png
       saía de 358KB a 4,1MB (lossless, cena fotográfica) — jpg é o
       padrão já usado em todas as outras fotos do site e cai pra uma
       fração disso sem perda visível para o público-alvo do fallback. -->
  <Picture
    src={fachada}
    alt="Fachada da casa principal do Rancho Mariana ao entardecer, luz dourada sobre o telhado de telha cerâmica, redes na varanda e luzes acesas por dentro."
    class="hero__imagem"
    data-parallax
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[480, 768, 1200, 1920]}
    sizes="100vw"
    fetchpriority="high"
    loading="eager"
  />
  <div class="hero__veu" aria-hidden="true"></div>
  <div class="hero__conteudo container" data-reveal>
    <span class="eyebrow hero__eyebrow">Rancho Mariana · Brotas, SP</span>
    <h1 id="hero-titulo" class="display hero__frase">
      Uma casa inteira, um vale inteiro, e o resto do mundo longe.
    </h1>
    <p class="hero__promessa">
      A casa inteira, cuidada em cada detalhe, com privacidade absoluta e
      vista para o vale — e uma anfitriã que responde em uma hora.
    </p>
    <CTABotao />
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    /* aspect-ratio 4/5 uniforme em todas as larguras agora — sem
       vídeo, não há mais divisão desktop/mobile pra essa seção nem
       position:sticky, então overflow:hidden aqui não tem o risco que
       tinha na versão em vídeo (it. 8). */
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .hero__imagem {
    position: absolute;
    left: 0;
    /* altura maior que a caixa (130%) + recuo negativo (-15%): dá
       margem de sobra pro paralaxe (Efeito 2, motion.js) deslocar a
       foto até 12% da altura sem abrir vão nas bordas — object-fit:
       cover já recorta o excesso, então isso não muda o enquadramento. */
    top: -15%;
    width: 100%;
    height: 130%;
    object-fit: cover;
    object-position: center 42%;
  }

  /* véu vertical monocromático — único degradê permitido, DESIGN.md §7 */
  .hero__veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(var(--veil), 0.72) 0%,
      rgba(var(--veil), 0.32) 45%,
      rgba(var(--veil), 0) 75%
    );
  }

  .hero__conteudo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: var(--space-48);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  /* --terra-soft não pode ser cor de texto (DESIGN.md §4.3) — sobre o
     véu escuro usa-se --on-photo, como o resto do conteúdo do herói. */
  .hero__eyebrow {
    color: var(--on-photo);
    opacity: 0.85;
  }

  .hero__frase {
    color: var(--on-photo);
    max-width: 14ch;
  }

  @media (min-width: 768px) {
    .hero__frase {
      max-width: 20ch;
    }
  }

  .hero__promessa {
    color: var(--on-photo);
    font-size: var(--fs-body);
    max-width: 42ch;
    margin: 0;
  }
</style>
