---
// Sitemap §13.2 item 8 — seção completa de avaliações, na posição
// narrativa (a faixa compacta já cobriu "prova social cedo" na §6).
// It. 6 (teste da troca): a citação única + lista de adjetivos soltos
// funcionava pra qualquer casa de campo. Trocado por mais três falas
// reais e pela contagem real de menções por tema — ambos direto de
// Material/pesquisa-fontes.md, que não estava disponível quando este
// componente foi escrito na it. 1.
const maisCitacoes = [
  '"A gente se sente em casa."',
  '"Vista exuberante do vale, algo para ficar contemplando."',
  '"Voltaremos com certeza" — frase recorrente nas avaliações.',
];

const mencoes = [
  { tema: 'Hospitalidade', contagem: 49 },
  { tema: 'Família', contagem: 25 },
  { tema: 'Limpeza', contagem: 23 },
  { tema: 'Espaço interno', contagem: 20 },
  { tema: 'Vista', contagem: 19 },
];
---

<section class="secao oquedizem" aria-labelledby="oquedizem-titulo">
  <div class="container" data-reveal>
    <div class="secao__cabecalho">
      <span class="eyebrow">O que dizem</span>
      <h2 id="oquedizem-titulo" class="h1">5,0 em 74 avaliações, Superhost há 7 anos.</h2>
    </div>

    <blockquote class="oquedizem__quote h2">
      "É até mais bonito que nas fotos."
    </blockquote>
    <p class="corpo-secundario oquedizem__nota">
      Frase repetida por três hóspedes diferentes, de forma independente,
      nas avaliações do Airbnb.
    </p>

    <ul class="oquedizem__mais-citacoes corpo-secundario">
      {maisCitacoes.map((c) => <li>{c}</li>)}
    </ul>

    <ul class="oquedizem__tags">
      {mencoes.map((m) => <li class="oquedizem__tag">{m.tema} · {m.contagem}</li>)}
    </ul>
  </div>
</section>

<style>
  .oquedizem__quote {
    margin-top: var(--space-32);
    color: var(--terra);
    max-width: 20ch;
  }

  .oquedizem__nota {
    margin-top: var(--space-8);
  }

  .oquedizem__mais-citacoes {
    margin-top: var(--space-24);
    max-width: var(--text-measure);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .oquedizem__tags {
    margin-top: var(--space-32);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .oquedizem__tag {
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--terra-soft);
    color: var(--ink);
    font-size: var(--fs-body-sm);
  }
</style>
