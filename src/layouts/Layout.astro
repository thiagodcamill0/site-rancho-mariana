---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!--
      Favicon utilitário (it. 7) — não existe logo (CLAUDE.md), então é
      só a inicial em serifa sobre --terra, gerado em public/favicon.svg.
      Trocar por um logo de verdade quando existir; até lá isso só
      fecha o 404 de /favicon.ico que o Checker flagou na it. 2.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Fonte carregada sem bloquear o primeiro paint. Diagnóstico da it. 3
      (Lighthouse mobile, Slow 4G simulado): o <link rel="stylesheet">
      direto pra fonts.googleapis.com era render-blocking — ~900ms de
      FCP perdido, that atrasava o "element render delay" do LCP (a
      foto do herói, que não depende de fonte nenhuma pra pintar).
      display=swap já evitava texto invisível, mas não evitava o
      bloqueio do CSS em si. Padrão-preload é o jeito padrão e seguro de
      resolver isso sem mudar o resultado visual.
    -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@400;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@400;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@400;600&display=swap"
      />
    </noscript>
  </head>
  <body>
    <a href="#conteudo-principal" class="pular-conteudo">Pular para o conteúdo</a>
    <slot />
    <script src="../scripts/motion.js"></script>
  </body>
</html>

<style>
  /* Link de pular conteúdo (it. 5, auditoria de acessibilidade) — fora
     de tela até receber foco de teclado, então aparece com o mesmo
     tratamento de foco do resto do sistema (§8: 3px solid var(--ink),
     outline-offset 3px), sobre fundo --paper sólido pra ficar legível
     por cima do header. Escondido por clip/tamanho, não por transform:
     a regra global de prefers-reduced-motion zera todo transform, o
     que deixaria isso permanentemente visível pra quem pede menos
     movimento — aqui não é uma questão de movimento, é visibilidade. */
  .pular-conteudo {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    z-index: 100;
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-card);
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: none;
  }

  .pular-conteudo:focus {
    top: var(--space-8);
    left: var(--space-8);
    width: auto;
    height: auto;
    padding: var(--space-12) var(--space-16);
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
